USERS_SERVICE_NAME='users service'
USERS_SERVICE_VERSION=0.1.0
# Local Dev (SQLite): sqlite+aiosqlite:///./database.db
# Docker/Prod (Postgres): postgresql+asyncpg://user:pass@users-service_db:5432/users_service
USERS_DATABASE_URL=postgresql+asyncpg://user:pass@users-service_db:5432/users_service
USERS_RABBITMQ_HOST=rabbitmq
USERS_RABBITMQ_PORT=5672
USERS_RABBITMQ_USER=user
USERS_RABBITMQ_PASS=pass
USERS_SERVICE_PORT=8000
USERS_ENVIRONMENT=development
USERS_SENTRY_DSN=""
USERS_SENTRY_RELEASE=""
USERS_SERVER_URL="example.com"

